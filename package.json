{
  "name": "castalia-anima-memory",
  "version": "2.0.0",
  "description": "Emotional memory body MCP server: memory store/search/reflect/facts/entities with VAD-weighted retrieval, no runtime emotional state machine. Cross-library reflection ships as an opt-in CLI plugin.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/gen_version.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "fed-server": "node dist/fedServer.js",
    "full-pipeline": "node dist/plugins/fullPipeline/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.10.0",
    "picomatch": "^4.0.5",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.8.0"
  },
  "bin": {
    "castalia": "dist/index.js",
    "castalia-federation": "dist/fedServer.js",
    "castalia-full-pipeline": "dist/plugins/fullPipeline/cli.js"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
