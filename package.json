{
  "name": "castalia-anima",
  "version": "1.23.1",
  "description": "Castalia Anima — emotional memory MCP server: Castalia core + agent state, bias layer, user learning, emotion-weighted search",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/gen_version.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "fed-server": "node dist/fedServer.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.10.0",
    "picomatch": "^4.0.5",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.8.0"
  },
  "bin": {
    "castalia": "dist/index.js",
    "castalia-federation": "dist/fedServer.js"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "engines": {
    "node": ">=20"
  }
}
